{
  "version": 2,
  "buildCommand": "pnpm build",
  "devCommand": "pnpm dev",
  "installCommand": "pnpm install",
  "framework": "vite",
  "env": {
    "DATABASE_URL": {
      "description": "MySQL database connection string",
      "required": true
    },
    "JWT_SECRET": {
      "description": "JWT secret for session signing",
      "required": true
    },
    "VITE_APP_ID": {
      "description": "Manus OAuth App ID",
      "required": true
    },
    "OAUTH_SERVER_URL": {
      "description": "Manus OAuth Server URL",
      "required": true
    },
    "VITE_OAUTH_PORTAL_URL": {
      "description": "Manus OAuth Portal URL",
      "required": true
    },
    "OWNER_OPEN_ID": {
      "description": "Owner's Manus Open ID",
      "required": true
    },
    "OWNER_NAME": {
      "description": "Owner's name",
      "required": false
    },
    "BUILT_IN_FORGE_API_URL": {
      "description": "Manus Built-in API URL",
      "required": true
    },
    "BUILT_IN_FORGE_API_KEY": {
      "description": "Manus Built-in API Key",
      "required": true
    },
    "VITE_FRONTEND_FORGE_API_URL": {
      "description": "Manus Frontend API URL",
      "required": true
    },
    "VITE_FRONTEND_FORGE_API_KEY": {
      "description": "Manus Frontend API Key",
      "required": true
    },
    "VITE_ANALYTICS_ENDPOINT": {
      "description": "Analytics endpoint URL",
      "required": false
    },
    "VITE_ANALYTICS_WEBSITE_ID": {
      "description": "Analytics website ID",
      "required": false
    },
    "VITE_APP_TITLE": {
      "description": "Website title",
      "required": false
    },
    "VITE_APP_LOGO": {
      "description": "Website logo URL",
      "required": false
    }
  },
  "functions": {
    "server/_core/index.ts": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/server/_core/index.ts"
    }
  ]
}
